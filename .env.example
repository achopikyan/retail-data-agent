# Google AI Studio API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_ai_studio_key_here

# GCP project that will run the BigQuery jobs (billing project).
# Public datasets are free under the 1TB/month free tier.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Models — override only if you need to.
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Paths
PERSONA_CONFIG_PATH=config/personas.yaml
GOLDEN_TRIOS_PATH=data/golden_trios.json
CURATED_TRIOS_PATH=data/curated_trios.json
GOLDEN_EMBEDDINGS_PATH=data/golden_trios.embeddings.npy
APP_DB_PATH=data/app.db
LOG_DIR=logs

# Behavior
SQL_RETRY_LIMIT=2
LLM_RETRY_LIMIT=3
DEFAULT_USER_ID=demo_manager
