# =========================================================================
#  Required — fill these in
# =========================================================================

# Gemini API key from https://aistudio.google.com/apikey (free, 10 seconds)
GOOGLE_API_KEY=your_google_ai_studio_key_here

# The GCP project that BigQuery jobs are billed to (uses your 1 TB/mo
# free tier; no billing setup needed). The AI Studio key auto-creates a
# project named gen-lang-client-XXXXXXX — you can reuse that here.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# BigQuery authentication. Pick ONE of:
#   (a) Service account JSON (recommended, no interactive flow):
#       Set this to the absolute path of the JSON key. See README §2b
#       for instructions on creating the service account.
#   (b) gcloud Application Default Credentials:
#       Leave this commented out and run:
#         gcloud auth application-default login
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa-key.json

# =========================================================================
#  Optional — sensible defaults are baked in
# =========================================================================

# Models. Defaults are free-tier-friendly.
# (gemini-2.5-pro is on a strict free tier; we route the heavy steps
#  through Flash and fall back to Flash-Lite. Override if you have paid
#  quota and want Pro.)
GEMINI_MODEL_PRO=gemini-2.5-flash
GEMINI_MODEL_FLASH=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Paths (relative to repo root)
PERSONA_CONFIG_PATH=config/personas.yaml
GOLDEN_TRIOS_PATH=data/golden_trios.json
CURATED_TRIOS_PATH=data/curated_trios.json
GOLDEN_EMBEDDINGS_PATH=data/golden_trios.embeddings.npy
APP_DB_PATH=data/app.db
LOG_DIR=logs

# Behavior
SQL_RETRY_LIMIT=2
LLM_RETRY_LIMIT=3
DEFAULT_USER_ID=demo_manager
